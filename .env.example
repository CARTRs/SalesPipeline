# ========== 数据库 ==========
DATABASE_URL=postgresql+asyncpg://sjxt:sjxt@localhost:5433/opportunity_db

# ========== Redis ==========
REDIS_URL=redis://localhost:6380/0

# ========== JWT密钥（生产环境务必修改） ==========
JWT_SECRET=sjxt-jwt-secret-change-in-production

# ========== AI API（兼容 OpenAI 格式，支持 DeepSeek / 通义千问 / 智谱等） ==========
# AI_API_KEY=DEEPSEEK_API_KEY（旧名也兼容）
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-chat

# ========== SMTP 邮件（可选） ==========
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_SENDER=

# ========== 应用配置 ==========
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

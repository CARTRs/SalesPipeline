{
  "name": "商机跟踪系统",
  "description": "商机智能跟踪与预警系统 MCP Server，支持查询和更新商机信息",
  "version": "1.0.0",
  "baseUrl": "http://localhost:8080",
  "tools": [
    {
      "name": "sjxt_login",
      "description": "登录商机跟踪系统，获取访问凭证。使用用户名和密码认证。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "系统用户名"
          },
          "password": {
            "type": "string",
            "description": "系统密码"
          }
        },
        "required": ["username", "password"]
      }
    },
    {
      "name": "sjxt_query_opportunities",
      "description": "查询当前用户相关的商机列表。返回商机基本信息、状态、金额等。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "登录返回的 access_token"
          },
          "keyword": {
            "type": "string",
            "description": "搜索关键词（可选，按商机名称或客户名称模糊匹配）"
          },
          "status": {
            "type": "string",
            "description": "筛选状态（可选）：正常推进/需推进/已签约/长期跟踪"
          },
          "page": {
            "type": "integer",
            "description": "页码，默认1",
            "default": 1
          },
          "page_size": {
            "type": "integer",
            "description": "每页数量，默认20",
            "default": 20
          }
        },
        "required": ["token"]
      }
    },
    {
      "name": "sjxt_get_opportunity",
      "description": "获取单个商机的详细信息，包括三角色人员、AI分析结果、风险状态等。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "登录返回的 access_token"
          },
          "opportunity_id": {
            "type": "integer",
            "description": "商机ID"
          }
        },
        "required": ["token", "opportunity_id"]
      }
    },
    {
      "name": "sjxt_update_opportunity",
      "description": "更新商机信息。只能更新自己负责的商机，且只能更新部分字段。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "登录返回的 access_token"
          },
          "opportunity_id": {
            "type": "integer",
            "description": "商机ID"
          },
          "opportunity_status": {
            "type": "string",
            "description": "商机状态：正常推进/需推进/已签约/长期跟踪"
          },
          "requirement_detail": {
            "type": "string",
            "description": "客户需求详情"
          },
          "remarks": {
            "type": "string",
            "description": "备注"
          },
          "estimated_sign_date": {
            "type": "string",
            "description": "预计签约日期，格式：YYYY-MM-DD"
          },
          "final_amount": {
            "type": "number",
            "description": "最终签约金额（万元）"
          },
          "contract_code": {
            "type": "string",
            "description": "合同编码"
          }
        },
        "required": ["token", "opportunity_id"]
      }
    },
    {
      "name": "sjxt_add_progress",
      "description": "为商机添加进度记录。提交后会自动触发AI分析和邮件通知。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "登录返回的 access_token"
          },
          "opportunity_id": {
            "type": "integer",
            "description": "商机ID"
          },
          "progress_content": {
            "type": "string",
            "description": "进度内容，描述本次推进情况"
          },
          "progress_date": {
            "type": "string",
            "description": "进度日期，格式：YYYY-MM-DD（可选，默认今天）"
          }
        },
        "required": ["token", "opportunity_id", "progress_content"]
      }
    },
    {
      "name": "sjxt_list_progress",
      "description": "获取商机的进度历史记录列表。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "登录返回的 access_token"
          },
          "opportunity_id": {
            "type": "integer",
            "description": "商机ID"
          }
        },
        "required": ["token", "opportunity_id"]
      }
    }
  ]
}
